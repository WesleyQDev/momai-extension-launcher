{
  "id": "momai-open",
  "name": "MomAI Open",
  "version": "1.1.1",
  "kind": "packaged",
  "description": "Abre programas, aplicativos e pastas no computador. Busca no menu iniciar, desktop, Program Files e PATH do sistema.",
  "icon_bg": "#0066CC",
  "icon": "launcher",
  "author": "WesleyQDev",
  "structuredTypes": ["generic-extension"],
  "sdkVersion": 1,
  "momai_compat": ">=1.7.0",
  "api": {
    "actions": ["/launcher/open"]
  },
  "permissions": ["filesystem:read", "process:spawn"],
  "theme": {
    "gradient": "from-blue-500 to-indigo-600",
    "accent": "blue"
  }
}

