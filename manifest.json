{
  "id": "momai-open",
  "name": "MomAI Open",
  "version": "1.1.2",
  "kind": "packaged",
  "is_official": true,
  "description": "Abra programas, pastas e arquivos do computador pedindo por voz ou texto.",
  "category": "utility",
  "tags": ["launcher", "open", "apps", "files", "folders"],
  "author": "WesleyQDev",
  "repo": "WesleyQDev/momai-open",
  "icon_bg": "#0066CC",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\"/><path d=\"M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z\" fill=\"#ffffff\" fill-opacity=\"0.18\"/><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0\"/><path d=\"M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"/></svg>",
  "sidebar_icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\"/><path d=\"M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z\" fill=\"#38bdf8\" fill-opacity=\"0.15\"/><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0\"/><path d=\"M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"/></svg>",
  "readme": {
    "pt-BR": "README.md",
    "en-US": "README.en-US.md"
  },
  "locales": {
    "pt-BR": {
      "name": "MomAI Open",
      "description": "Abra programas, pastas e arquivos do computador pedindo por voz ou texto.",
      "category": "utility",
      "tags": ["lançador", "abrir", "aplicativos", "arquivos", "pastas"]
    },
    "en-US": {
      "name": "MomAI Open",
      "description": "Opens programs, apps, folders, files and URLs on your computer via voice or text commands.",
      "category": "utility",
      "tags": ["launcher", "open", "apps", "files", "folders"]
    }
  },
  "structuredTypes": ["generic-extension"],
  "sdkVersion": 1,
  "momai_compat": ">=1.11.0",
  "tools": [
    {
      "name": "search_local_items",
      "label": "Buscar programas e pastas",
      "description": "Busca pastas, arquivos, programas e aplicativos no computador local por nome. Use para abrir ou encontrar qualquer item.",
      "parameters": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "Nome ou termo do item a buscar (pasta, arquivo ou programa)" }
        }
      }
    },
    {
      "name": "open_local_item",
      "label": "Abrir item local",
      "description": "Abre pasta, arquivo ou programa pelo caminho absoluto retornado por search_local_items.",
      "parameters": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "description": "Caminho absoluto do item" },
          "name": { "type": "string", "description": "Nome do item para confirmacao" }
        }
      }
    }
  ],
  "api": {
    "actions": ["/launcher/open"]
  },
  "permissions": ["filesystem:read", "process:spawn"],
  "theme": {
    "gradient": "from-blue-500 to-indigo-600",
    "accent": "blue"
  }
}
